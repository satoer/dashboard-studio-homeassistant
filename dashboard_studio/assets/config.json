{
  "environment": "homeassistant",
  "ui": {
    "showDataConnection": true,
    "showLocalButtons": true,
    "showServerButtons": true,
    "warnWhenDriverOffline": false,
    "hiddenDrivers": ["homey", "nodered"],
    "hiddenWidgets": []
  },
  "defaults": {
    "dataDriver": "homeassistant",
    "hideEditor": false,
    "cacheValues": true
  },
  "storage": {
    "endpoints": {
      "dashboard": "/dashboards",
      "template": "/templates"
    }
  }
}
