        "dialogWidth": 360,
        "dialogHeight": 180,
        "centerDialog": true,
        "dialogX": 0,
        "dialogY": 0,
        "modalMode": true,
        "icons": {
          "dialog": {
            "size": 50
          },
          "confirm": {
            "source": "phosphor",
            "builtin": "ph-check",
            "weight": "bold",
            "customUrl": "",
            "tintImage": false,
            "color": "@onAccent",
            "accentColor": "@iconAccent",
            "size": 18
          },
          "dismiss": {
            "source": "phosphor",
            "builtin": "ph-x",
            "weight": "bold",
            "customUrl": "",
            "tintImage": false,
            "color": "@onAccent",
            "accentColor": "@iconAccent",
            "size": 18
          }
        }
      }
