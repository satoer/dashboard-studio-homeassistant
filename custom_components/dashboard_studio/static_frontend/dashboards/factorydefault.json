        "message": "Are you sure?",
        "confirmLabel": "Yes",
        "dismissLabel": "No",
        "buttonColor": "@accent",
        "showButtonIcons": false,
        "showDialogIcon": true,
        "autoButtonSize": true,
        "buttonWidth": 120,
        "buttonHeight": 40,
        "backgroundColor": "@surface",
        "borderColor": "@borderAccent",
