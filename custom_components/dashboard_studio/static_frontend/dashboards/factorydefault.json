{
  "version": "2.4.0",
  "master": {
    "connection": {
      "dataDriver": "homeassistant",
      "driverSettings": {
        "namespace": "undefined"
      }
    },
    "environment": {
      "editorMode": "advanced",
      "editorZoom": 100,
      "widgetLabelMode": "hover",
      "holdToActivateDuration": 1.5,
      "preloadImagesOnAllPages": false,
      "hideScrollbars": false,
      "quickToolbar": {
        "visibility": "auto",
        "enabled": true,
        "mode": "docked",
        "x": 0,
        "y": 0,
        "columns": 1,
        "rows": 0
      },
      "canvas": {
        "width": 1180,
        "height": 820,
        "preset": "1180,820",
        "background": {
          "startColor": "@background",
          "startOpacity": 100,
          "endColor": "@backgroundAccent",
          "endOpacity": 100,
          "type": "radial",
          "angle": 0,
          "overlay": false,
          "image": "",
          "size": "cover"
        }
      },
      "grid": {
        "size": 10,
        "show": true,
        "snap": true
      },
      "paging": {
        "currentPage": 1,
        "currentPageOutputTopic": "",
        "inactivityPageEnabled": false,
        "inactivityReturnPage": 1,
        "inactivityTimeoutSeconds": 60
      },
      "gestures": {
        "touchOnly": true,
        "swipeLeft": {
          "enabled": false,
          "action": "next_page",
          "page": 1,
          "topic": "",
          "payload": ""
        },
        "swipeRight": {
          "enabled": false,
          "action": "prev_page",
          "page": 1,
          "topic": "",
          "payload": ""
        },
        "swipeUp": {
          "enabled": false,
          "action": "topic",
          "page": 1,
          "topic": "",
          "payload": ""
        },
        "swipeDown": {
          "enabled": false,
          "action": "topic",
          "page": 1,
          "topic": "",
          "payload": ""
        },
        "paging": {
          "ignorePages": "",
          "wrapAround": false
        }
      },
      "theme": "default_dark",
      "layout": {
        "mode": "fixed",
        "scale": {
          "keepAspectRatio": true
        }
      },
      "audio": {
        "topicMap": []
      },
      "editorTooltips": true,
      "locale": "auto",
      "timeFormat": "auto",
      "dateFormat": "auto",
      "firstDayOfWeek": "auto",
